# NetForge Environment Configuration
# Copy this file to .env and configure local values.
# NEVER commit .env with real credentials.

# Database
DATABASE_URL=postgres://netforge:netforge@localhost:5432/netforge?sslmode=disable

# Application
NETFORGE_ENV=development
LOG_LEVEL=info

# LLM Provider (Introduced later in research milestones)
LLM_PROVIDER=gemini
LLM_API_KEY=your_api_key_here

